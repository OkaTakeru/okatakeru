<% @tweet.tags.each do |tag| %>
    <span><%= tag.name %></span>
<% end %>

<h3>Tweet詳細</h3>
<div class="tweet">
  <p><%= @tweet.body %></p>
  <p><%= @tweet.created_at %></p>
  <% if @tweet.image.attached? %>
     <%= image_tag @tweet.image, size: '250x200'%>
  <% end %>
</div>

<%= link_to "Tweet一覧に戻る", tweets_path %>